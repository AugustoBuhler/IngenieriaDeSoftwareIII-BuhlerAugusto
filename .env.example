# Copia este archivo a .env (git lo ignora) y pone un valor real:
#   cp .env.example .env
#
# El .env NUNCA se commitea: un secreto en el historial de un repo publico queda
# ahi para siempre. Este .env.example si se commitea, y es documentacion
# ejecutable: le dice a quien clone que variables hacen falta.
DB_PASSWORD=super-secreto-local
